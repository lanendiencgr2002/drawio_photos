<mxfile host="Electron" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/28.0.6 Chrome/138.0.7204.100 Electron/37.2.3 Safari/537.36" version="28.0.6">
  <diagram name="第 1 页" id="xM4GF8KPHChY5Br-Ip8q">
    <mxGraphModel dx="2231" dy="1053" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="JOjQzGkAwvjCkKzLWuYa-1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="780" height="80" as="geometry" />
        </mxCell>
        <mxCell id="JOjQzGkAwvjCkKzLWuYa-2" value="在实际的企业开发过程中，你会发现外键是被严格禁止使用的，当需要多个表之间进行关联时，做法是冗余相关字段，而不是建立外键。" style="text;whiteSpace=wrap;html=1;fontSize=16;fontStyle=1;fontColor=#664d00;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="30" y="30" width="760" height="60" as="geometry" />
        </mxCell>
        <mxCell id="JOjQzGkAwvjCkKzLWuYa-3" value="【 案例演示与定义 】" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fontSize=14;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="20" y="120" width="380" height="880" as="geometry" />
        </mxCell>
        <mxCell id="JOjQzGkAwvjCkKzLWuYa-4" value="成绩表（成绩 id、学生 id，分数），对于成绩表来说，学生 id 就是外键" style="text;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;" vertex="1" parent="JOjQzGkAwvjCkKzLWuYa-3">
          <mxGeometry x="15" y="45" width="350" height="50" as="geometry" />
        </mxCell>
        <mxCell id="JOjQzGkAwvjCkKzLWuYa-5" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#282c34;strokeColor=#181a1f;" vertex="1" parent="JOjQzGkAwvjCkKzLWuYa-3">
          <mxGeometry x="10" y="100" width="360" height="300" as="geometry" />
        </mxCell>
        <mxCell id="JOjQzGkAwvjCkKzLWuYa-6" value="&lt;span style=&quot;color: #c678dd;&quot;&gt;CREATE&lt;/span&gt; &lt;span style=&quot;color: #c678dd;&quot;&gt;TABLE&lt;/span&gt; &lt;span style=&quot;color: #98c379;&quot;&gt;`score`&lt;/span&gt; (&lt;br/&gt;&lt;span style=&quot;color: #98c379;&quot;&gt;`id`&lt;/span&gt; &lt;span style=&quot;color: #e6c07b;&quot;&gt;bigint&lt;/span&gt;(20) &lt;span style=&quot;color: #c678dd;&quot;&gt;unsigned&lt;/span&gt; &lt;span style=&quot;color: #c678dd;&quot;&gt;NOT NULL&lt;/span&gt; AUTO_INCREMENT,&lt;br/&gt;&lt;span style=&quot;color: #98c379;&quot;&gt;`student_id`&lt;/span&gt; &lt;span style=&quot;color: #e6c07b;&quot;&gt;bigint&lt;/span&gt;(20) &lt;span style=&quot;color: #c678dd;&quot;&gt;unsigned&lt;/span&gt; &lt;span style=&quot;color: #c678dd;&quot;&gt;NOT NULL&lt;/span&gt;,&lt;br/&gt;&lt;span style=&quot;color: #98c379;&quot;&gt;`score`&lt;/span&gt; &lt;span style=&quot;color: #e6c07b;&quot;&gt;int&lt;/span&gt;(20) &lt;span style=&quot;color: #c678dd;&quot;&gt;unsigned&lt;/span&gt; &lt;span style=&quot;color: #c678dd;&quot;&gt;NOT NULL&lt;/span&gt;,&lt;br/&gt; PRIMARY &lt;span style=&quot;color: #c678dd;&quot;&gt;KEY&lt;/span&gt; (&lt;span style=&quot;color: #98c379;&quot;&gt;`id`&lt;/span&gt;),&lt;br/&gt; &lt;span style=&quot;color: #c678dd;&quot;&gt;KEY&lt;/span&gt; &lt;span style=&quot;color: #98c379;&quot;&gt;`student_id`&lt;/span&gt; (&lt;span style=&quot;color: #98c379;&quot;&gt;`student_id`&lt;/span&gt;),&lt;br/&gt;&lt;font color=&quot;#ff7b72&quot;&gt;CONSTRAINT `fk_student_id` FOREIGN KEY (`student_id`) REFERENCES `student` (`id`)&lt;/font&gt;&lt;br/&gt;) &lt;span style=&quot;color: #c678dd;&quot;&gt;ENGINE&lt;/span&gt;=&lt;span style=&quot;color: #c678dd;&quot;&gt;InnoDB&lt;/span&gt; &lt;span style=&quot;color: #c678dd;&quot;&gt;CHARSET&lt;/span&gt;=utf8mb4;" style="text;whiteSpace=wrap;html=1;fontSize=12;fontColor=#abb2bf;fontFamily=Consolas,Monaco,monospace;" vertex="1" parent="JOjQzGkAwvjCkKzLWuYa-3">
          <mxGeometry x="20" y="110" width="340" height="280" as="geometry" />
        </mxCell>
        <mxCell id="JOjQzGkAwvjCkKzLWuYa-7" value="&lt;b&gt;外键约束行为说明：&lt;/b&gt;&lt;br/&gt;1. 引用完整性：插入 student_id 必须存在于学生表；&lt;br/&gt;2. 级联动作：学生表删除/更新时，自动操作成绩表关联数据。" style="text;whiteSpace=wrap;html=1;fontSize=13;spacingTop=10;" vertex="1" parent="JOjQzGkAwvjCkKzLWuYa-3">
          <mxGeometry x="15" y="420" width="350" height="440" as="geometry" />
        </mxCell>
        <mxCell id="JOjQzGkAwvjCkKzLWuYa-8" value="【 深度解析：为什么不推荐？ 】" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fontSize=14;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="420" y="120" width="380" height="880" as="geometry" />
        </mxCell>
        <mxCell id="JOjQzGkAwvjCkKzLWuYa-9" value="核心矛盾：性能 vs 一致性" style="text;whiteSpace=wrap;html=1;fontSize=15;fontStyle=1;fontColor=#990000;align=center;" vertex="1" parent="JOjQzGkAwvjCkKzLWuYa-8">
          <mxGeometry x="15" y="45" width="350" height="30" as="geometry" />
        </mxCell>
        <mxCell id="JOjQzGkAwvjCkKzLWuYa-10" value="&lt;p&gt;1. &lt;b&gt;性能损耗&lt;/b&gt;：每次操作都要检查约束，影响插入速度。&lt;/p&gt;&lt;p&gt;2. &lt;b&gt;更新风暴 (Update Storm)&lt;/b&gt;：级联更新是强阻塞，高并发下会导致锁竞争甚至死锁，令数据库性能急剧下降。&lt;/p&gt;&lt;p&gt;3. &lt;b&gt;扩展限制&lt;/b&gt;：分库分表环境下，外键难以跨库建立联系。&lt;/p&gt;&lt;p&gt;4. &lt;b&gt;适用场景&lt;/b&gt;：外键不适合分布式高并发集群，仅在单机低并发业务中可考虑使用。&lt;/p&gt;" style="text;whiteSpace=wrap;html=1;fontSize=14;lineHeight=1.5;" vertex="1" parent="JOjQzGkAwvjCkKzLWuYa-8">
          <mxGeometry x="15" y="90" width="350" height="760" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
