        <mxCell id="legend4" value="⚡ 性能提示：字符串字面量复用常量池，避免重复创建" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#E74C3C;fontStyle=1;" vertex="1" parent="1">
