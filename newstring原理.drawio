        </mxCell>
        <mxCell id="concept_note" value="💡 核心概念&#xa;&#xa;• String s1 = &quot;yupi&quot; → 直接使用常量池&#xa;• String s2 = new String(&quot;yupi&quot;) → 创建新对象&#xa;• s1 == s2 → false (不同对象)&#xa;• s1.equals(s2) → true (内容相同)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9E7;strokeColor=#F39C12;strokeWidth=2;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingTop=10;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="530" width="280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="performance_note" value="⚡ 性能对比&#xa;&#xa;字面量方式：高效，复用已存在对象&#xa;new方式：每次创建新对象，消耗更多内存&#xa;&#xa;推荐：优先使用字符串字面量" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F6F3;strokeColor=#16A085;strokeWidth=2;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingTop=10;spacingLeft=10;" vertex="1" parent="1">
