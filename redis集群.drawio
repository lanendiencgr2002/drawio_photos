  <diagram id="AavGLiPr7reHICdNdflX" name="集群扩容">
    <mxGraphModel dx="1276" dy="614" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="k-HD9OdMNxIXulwnTEDW-1" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
          <mxGeometry width="514.28" height="300" as="geometry" />
        </mxCell>
        <mxCell id="PiYJKdlOJww87HHEed85-5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=18;" edge="1" parent="1" source="k-HD9OdMNxIXulwnTEDW-4" target="k-HD9OdMNxIXulwnTEDW-5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="k-HD9OdMNxIXulwnTEDW-4" value="1、加入一个新的主节点&#xa;redis-cli -a 密码 --cluster add-node 自己实际IP地址:6387 自己实际IP地址:6381&#xa;6381作为原有集群入口（-c作为一大坨redis中的主redis），帮助6387作为新主节点（第四个）加入集群。&#xa;redis-cli -a 111111 --cluster add-node 192.168.111.184:6387 192.168.111.185:6381" style="text;whiteSpace=wrap;fontSize=18;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="1" vertex="1">
          <mxGeometry x="10" y="290" width="870" height="100" as="geometry" />
        </mxCell>
        <mxCell id="PiYJKdlOJww87HHEed85-3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=18;" edge="1" parent="1" source="A8PLJa22I2JlP9rOvOnV-2" target="PiYJKdlOJww87HHEed85-2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="A8PLJa22I2JlP9rOvOnV-2" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
          <mxGeometry x="890" y="470.00000000000006" width="492" height="347.81" as="geometry" />
        </mxCell>
        <mxCell id="PiYJKdlOJww87HHEed85-9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=18;" edge="1" parent="1" source="tsRaaz_bii2YT1n1nhCX-1" target="A8PLJa22I2JlP9rOvOnV-2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tsRaaz_bii2YT1n1nhCX-1" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
          <mxGeometry x="1500" y="467.5" width="568" height="352.81" as="geometry" />
        </mxCell>
        <mxCell id="PiYJKdlOJww87HHEed85-2" value="2、重新分派槽号&#xa;命令:redis-cli -a 密码 --cluster reshard IP地址:端口号&#xa;redis-cli -a 密码 --cluster reshard 192.168.111.175:6381&#xa;&#xa;1、填16382/4=4096，Redis集群重新分派4096个槽位给第四个主节点&#xa;2、填第四个主的ID" style="text;whiteSpace=wrap;fontSize=18;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="10" y="420" width="570" height="150" as="geometry" />
        </mxCell>
        <mxCell id="PiYJKdlOJww87HHEed85-4" value="" style="group" vertex="1" connectable="0" parent="1">
          <mxGeometry x="1060" y="230" width="1200" height="211" as="geometry" />
        </mxCell>
        <mxCell id="k-HD9OdMNxIXulwnTEDW-5" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="PiYJKdlOJww87HHEed85-4" vertex="1">
          <mxGeometry y="60" width="1200" height="151" as="geometry" />
        </mxCell>
        <mxCell id="k-HD9OdMNxIXulwnTEDW-7" value="但是没有分配到槽位：在集群中任意一台服务器上执行命令" style="text;whiteSpace=wrap;fontSize=18;" parent="PiYJKdlOJww87HHEed85-4" vertex="1">
          <mxGeometry width="610" height="40" as="geometry" />
        </mxCell>
        <mxCell id="PiYJKdlOJww87HHEed85-6" value="3、为主节点6387分配从节点6388&#xa;命令：redis-cli -a 密码 --cluster add-node ip:新slave端口 ip:新master端口 --cluster-slave --cluster-master-id 新主机节点ID&#xa;redis-cli -a 111111 --cluster add-node 192.168.111.174:6388 192.168.111.174:6387 --cluster-slave --cluster-master-id 4feb6a7ee0ed2b39ff86474cf4189ab2a554a40f------这个是6387的编号，按照自己实际情况" style="text;whiteSpace=wrap;fontSize=18;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="10" y="660" width="560" height="170" as="geometry" />
        </mxCell>
        <mxCell id="PiYJKdlOJww87HHEed85-7" value="CLUSTER NODES：查看节点信息" style="text;whiteSpace=wrap;fontSize=18;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="550" y="30" width="300" height="40" as="geometry" />
        </mxCell>
        <mxCell id="PiYJKdlOJww87HHEed85-8" value="4、检查集群情况第3次&#xa;redis-cli --cluster check 真实ip地址:6381&#xa;redis-cli -a 111111 --cluster check 192.168.111.175:6381" style="text;whiteSpace=wrap;fontSize=18;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="20" y="940" width="470" height="80" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
