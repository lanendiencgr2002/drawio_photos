<mxfile host="Electron" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/24.7.5 Chrome/126.0.6478.183 Electron/31.3.0 Safari/537.36" version="24.7.5" pages="6">
  <diagram id="NxikZcFPbIt1c1rpH8HU" name="能干嘛">
    <mxGraphModel dx="998" dy="561" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="igQVh9VwVPjq-cHt7PZL-22" value="Redis集群通过多个复制集的水平扩展实现大规模数据分片存储，每个复制集只负责存储整个数据集的一部分。" style="text;whiteSpace=wrap;fontSize=18;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="1" vertex="1">
          <mxGeometry x="20" y="10" width="570" height="60" as="geometry" />
        </mxCell>
        <mxCell id="igQVh9VwVPjq-cHt7PZL-23" value="" style="group" parent="1" vertex="1" connectable="0">
          <mxGeometry x="20" y="350" width="800" height="610" as="geometry" />
        </mxCell>
        <mxCell id="2" value="能干嘛" style="rounded=1;whiteSpace=wrap;html=1;fontSize=24;fontStyle=1;fillColor=#000000;strokeColor=#000000;fontColor=#FFFFFF;shadow=1;" parent="igQVh9VwVPjq-cHt7PZL-23" vertex="1">
          <mxGeometry y="294.1071428571429" width="100.85106382978724" height="65.35714285714286" as="geometry" />
        </mxCell>
        <mxCell id="3" value="Redis集群支持多个Master，每个Master又可以挂载多个Slave" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#ffffff;strokeColor=#000000;shadow=1;align=left;spacingLeft=5;spacingRight=5;" parent="igQVh9VwVPjq-cHt7PZL-23" vertex="1">
          <mxGeometry x="151.27659574468086" y="43.57142857142857" width="369.78723404255317" height="65.35714285714286" as="geometry" />
        </mxCell>
        <mxCell id="4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=3;endArrow=classic;endFill=1;" parent="igQVh9VwVPjq-cHt7PZL-23" source="2" target="3" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="5" value="客户端与Redis的节点连接，不再需要连接集群中所有的节点，只需要任意连接集群中的一个可用节点即可" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#ffffff;strokeColor=#000000;shadow=1;align=left;spacingLeft=5;spacingRight=5;" parent="igQVh9VwVPjq-cHt7PZL-23" vertex="1">
          <mxGeometry x="151.27659574468086" y="294.1071428571429" width="470.63829787234044" height="65.35714285714286" as="geometry" />
        </mxCell>
        <mxCell id="6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=3;endArrow=classic;endFill=1;" parent="igQVh9VwVPjq-cHt7PZL-23" source="2" target="5" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7" value="由于Cluster自带Sentinel的故障转移机制，内置了高可用的支持，无需再去使用哨兵功能" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#ffffff;strokeColor=#000000;shadow=1;align=left;spacingLeft=5;spacingRight=5;" parent="igQVh9VwVPjq-cHt7PZL-23" vertex="1">
          <mxGeometry x="151.27659574468086" y="163.39285714285714" width="470.63829787234044" height="65.35714285714286" as="geometry" />
        </mxCell>
        <mxCell id="8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=3;endArrow=classic;endFill=1;" parent="igQVh9VwVPjq-cHt7PZL-23" source="2" target="7" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="9" value="槽位slot负责分配到各个物理服务节点，由对应的集群来负责维护节点、插槽和数据之间的关系" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#ffffff;strokeColor=#000000;shadow=1;align=left;spacingLeft=5;spacingRight=5;" parent="igQVh9VwVPjq-cHt7PZL-23" vertex="1">
          <mxGeometry x="151.27659574468086" y="424.82142857142856" width="470.63829787234044" height="65.35714285714286" as="geometry" />
        </mxCell>
        <mxCell id="10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=3;endArrow=classic;endFill=1;" parent="igQVh9VwVPjq-cHt7PZL-23" source="2" target="9" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="11" value="支持数据的高可用" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#E1F5FE;strokeColor=#0288D1;shadow=1;" parent="igQVh9VwVPjq-cHt7PZL-23" vertex="1">
          <mxGeometry x="605.1063829787234" width="151.27659574468086" height="43.57142857142857" as="geometry" />
        </mxCell>
        <mxCell id="12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=2;endArrow=classic;endFill=1;strokeColor=#0288D1;" parent="igQVh9VwVPjq-cHt7PZL-23" source="3" target="11" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="13" value="支持海量数据的读写存储操作" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#E1F5FE;strokeColor=#0288D1;shadow=1;" parent="igQVh9VwVPjq-cHt7PZL-23" vertex="1">
          <mxGeometry x="605.1063829787234" y="65.35714285714286" width="184.89361702127658" height="43.57142857142857" as="geometry" />
        </mxCell>
        <mxCell id="14" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=2;endArrow=classic;endFill=1;strokeColor=#0288D1;" parent="igQVh9VwVPjq-cHt7PZL-23" source="3" target="13" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="22" value="Redis集群通过分片来进行数据共享，并提供复制和故障转移功能" style="shape=note;strokeWidth=2;fontSize=14;size=20;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#666600;align=left;spacingLeft=5;" parent="igQVh9VwVPjq-cHt7PZL-23" vertex="1">
          <mxGeometry x="226.9102127659575" y="530.0028571428571" width="294.1489361702127" height="65.35714285714286" as="geometry" />
        </mxCell>
        <mxCell id="4N-3mVtRwJV2TZ-dvj3m-22" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
          <mxGeometry x="10" y="80" width="767.77" height="270" as="geometry" />
        </mxCell>
        <mxCell id="HsjtRGXvs6dT7UpH9ut1-22" value="简介：&#xa;主如果宕机后，重新上位不会还是主了&#xa;redis集群不保证强一致，比如写主，主挂了，从上位。" style="text;whiteSpace=wrap;fontSize=18;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="60" y="980" width="470" height="90" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="CRWI0WKoVwSpvMKcuYGq" name="集群哈希槽算法">
    <mxGraphModel dx="848" dy="477" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="C_Wvt8qkXErpMbcF982L-1" value="Redis集群通过将密钥空间分割为16384个哈希槽实现数据分片，理论上支持最多16384个主节点，但实际推荐限制在1000个节点以内以保证性能和稳定性。" style="text;whiteSpace=wrap;fontSize=18;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="10" y="20" width="700" height="50" as="geometry" />
        </mxCell>
        <mxCell id="C_Wvt8qkXErpMbcF982L-5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=18;" edge="1" parent="1" source="C_Wvt8qkXErpMbcF982L-3" target="C_Wvt8qkXErpMbcF982L-4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="C_Wvt8qkXErpMbcF982L-3" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" vertex="1" parent="1">
          <mxGeometry x="30" y="110" width="961" height="136" as="geometry" />
        </mxCell>
        <mxCell id="C_Wvt8qkXErpMbcF982L-4" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" vertex="1" parent="1">
          <mxGeometry x="53" y="330" width="614" height="435.62" as="geometry" />
        </mxCell>
        <mxCell id="C_Wvt8qkXErpMbcF982L-7" value="这种结构很容易添加或者删除节点.比如如果我想新添加个节点D，我需要从节点A，B，C中得部分槽到D上.如果我想移除节点&#xa;A.需要将A中的槽移到B和C节点上，然后将没有任何槽的A节点从集群中移除即可.由于从一个节点将哈希槽移动到另一个节点&#xa;并不会停止服务，所以无论添加删除或者改变某个节点的哈希槽的数量都不会造成集群不可用的状态." style="text;whiteSpace=wrap;fontSize=18;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="53" y="765.62" width="560" height="150" as="geometry" />
        </mxCell>
        <mxCell id="4KSUzMTLHaBTKhJqlIEd-1" value="为什么redis集群的最大槽数是16384个？" style="text;whiteSpace=wrap;fontSize=18;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="20" y="940" width="360" height="50" as="geometry" />
        </mxCell>
        <mxCell id="4KSUzMTLHaBTKhJqlIEd-2" value="16k槽数是折中选择：既可支持1000个主节点规模，又能确保心跳数据包中的槽位图能高效传输。&#xa;&#xa;(1)如果槽位为65536，发送心跳信息的消息头达8k，发送的心跳包过于庞大。&#xa;在消息头中最占空间的是myslots[CLUSTER_SLOTS/8]。当槽位为65536时，这块的大小是：65536÷8÷1024=8kb&#xa;在消息头中最占空间的是myslots[CLUSTER_SLOTS/8]。当槽位为16384时，这块的大小是：16384÷8÷1024=2kb&#xa;因为每秒钟，redis节点需要发送一定数量的ping消息作为心跳包，如果槽位为65536，这个ping消息的消息头太大了，浪费带宽。&#xa;&#xa;(2)redis的集群主节点数量基本不可能超过1000个。&#xa;集群节点越多，心跳包的消息体内携带的数据越多。如果节点过10oo个，也会导致网络拥堵。因此redis作者不建议rediscluster节点数量超过&#xa;1000个。那么，对于节点数在1000以内的rediscluster集群，16384个槽位够用了。没有必要拓展到65536个。&#xa;&#xa;(3)槽位越小，节点少的情况下，压缩比高，：容易传输&#xa;Redis主节点的配置信息中它所负责的哈希槽是通过一张bitmap的形式来保存的，在传输过程中会对bitmap进行压缩，但是如果bitmap的填充率&#xa;slots ／N很高的话(N表示节点数)，bitmap的压缩率就很低。如果节点数很少，而哈希槽数量很多的话，bitmap的压缩率就很低。" style="text;whiteSpace=wrap;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="20" y="1000" width="560" height="560" as="geometry" />
        </mxCell>
        <mxCell id="4KSUzMTLHaBTKhJqlIEd-3" value="不保证强一致性" style="text;whiteSpace=wrap;fontSize=18;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="10" y="1570" width="150" height="40" as="geometry" />
        </mxCell>
        <mxCell id="4KSUzMTLHaBTKhJqlIEd-4" value="写到主，然后主还没同步给从就挂了。" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=18;" vertex="1" parent="1">
          <mxGeometry y="1610" width="330" height="40" as="geometry" />
        </mxCell>
        <mxCell id="l1Mo8jsiBteWdVv98lPR-1" value="其他算法" style="text;whiteSpace=wrap;fontSize=18;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="20" y="1670" width="100" height="40" as="geometry" />
        </mxCell>
        <mxCell id="m4RSFNT--gGYQGm7X23o-1" value="用户每次读写操作通过计算 hash(key)%N 来确定数据所在的节点位置。&#xa;&#xa;传统哈希取模分片虽然实现简单直接，但在节点数量变化时会导致大规模数据迁移，不适合需要弹性伸缩的分布式系统。&#xa;" style="text;whiteSpace=wrap;fontSize=18;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="20" y="1720" width="560" height="140" as="geometry" />
        </mxCell>
        <mxCell id="m4RSFNT--gGYQGm7X23o-2" value="基于哈希环的数据存储策略，通过将节点顺时针排列，实现了节点变更时仅影响相邻节点的数据迁移，优点是变更操作影响范围小，缺点是数据分布不均匀。" style="text;whiteSpace=wrap;fontSize=18;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="20" y="1870" width="560" height="90" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="hrUfffBIspfyrh3KMopP" name="案例">
    <mxGraphModel dx="998" dy="561" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="JvjwG5LXbTWDC21l68Bf-1" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" vertex="1" parent="1">
          <mxGeometry x="10" y="70" width="874.72" height="320" as="geometry" />
        </mxCell>
        <mxCell id="JvjwG5LXbTWDC21l68Bf-2" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" vertex="1" parent="1">
          <mxGeometry x="470" y="440" width="807" height="277.99" as="geometry" />
        </mxCell>
        <mxCell id="JvjwG5LXbTWDC21l68Bf-4" value="在其中任意一台机器执行：redis-cli -a 111111 --cluster create --cluster-replicas 1 192.168.111.175:6381 192.168.111.175:6382 192.168.111.172:6383 192.168.111.172:6384 192.168.111.174:6385 192.168.111.174:6386&#xa;&#xa;--cluster-replicas 1 表示为每个master创建一个slave节点（会自行分配1主x从）" style="text;whiteSpace=wrap;fontSize=18;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="10" y="410" width="450" height="180" as="geometry" />
        </mxCell>
        <mxCell id="JvjwG5LXbTWDC21l68Bf-5" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" vertex="1" parent="1">
          <mxGeometry x="880" y="500" width="410" height="201.04" as="geometry" />
        </mxCell>
        <mxCell id="JvjwG5LXbTWDC21l68Bf-7" value="查看集群关系（任意一台节点机器上）：&#xa;CLUSTER NODES" style="text;whiteSpace=wrap;fontSize=18;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="10" y="631.04" width="360" height="70" as="geometry" />
        </mxCell>
        <mxCell id="JvjwG5LXbTWDC21l68Bf-8" value="启动6个redis服务" style="text;whiteSpace=wrap;fontSize=18;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="10" y="20" width="190" height="40" as="geometry" />
        </mxCell>
        <mxCell id="JvjwG5LXbTWDC21l68Bf-9" value="在Redis集群中，如果连接的节点（主节点才能写）不负责目标key所在的哈希槽(hash slot)，则无法直接进行写入操作。&#xa;这是因为Redis集群将16384个哈希槽分配给不同的节点管理，每个key都会根据CRC16算法映射到特定的槽位，只有负责该槽位的节点才能处理相应的读写请求。如果连接到了错误的节点，Redis会返回MOVED或ASK错误，提示客户端重定向到正确的节点。" style="text;whiteSpace=wrap;fontSize=18;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="10" y="750" width="490" height="160" as="geometry" />
        </mxCell>
        <mxCell id="JvjwG5LXbTWDC21l68Bf-11" value="redis-cli-a 111111-p 6381 -c：&#xa;该命令用于以集群模式连接 Redis，-c 参数可实现自动路由到正确的服务器槽位。" style="text;whiteSpace=wrap;fontSize=18;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="10" y="940" width="390" height="80" as="geometry" />
        </mxCell>
        <mxCell id="2p3pyH9Mhf2t5rLTxWoj-1" value="CLUSTER KEYSLOT k1：&#xa;1. 计算key的CRC16值&#xa;2. 将CRC16值对16384取模，得到槽位号&#xa;3. 返回槽位号" style="text;whiteSpace=wrap;fontSize=18;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="510" y="750" width="360" height="110" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
