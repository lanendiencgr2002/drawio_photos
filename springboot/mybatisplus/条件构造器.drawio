space: pre; word-spacing: normal; word-break: normal; line-height: 1.5; tab-size: 2; hyphens: none; padding: 1em; margin: 0.5em 0px; overflow: auto; border-radius: 0.3em;&quot;&gt;&lt;code class=&quot;language-java&quot; style=&quot;background: transparent; color: rgb(56, 58, 66); font-family: var(--font-mono); direction: ltr; text-align: left; white-space: pre; word-spacing: normal; word-break: normal; line-height: 1.5; tab-size: 2; hyphens: none;&quot;&gt;&lt;span&gt;&lt;span class=&quot;token&quot; style=&quot;color: rgb(160, 161, 167); font-style: italic;&quot;&gt;// 使用LambdaQueryWrapper - 通过Lambda表达式引用属性&lt;/span&gt;&lt;span&gt;&#xa;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&lt;span&gt;&lt;/span&gt;&lt;span class=&quot;token&quot; style=&quot;color: rgb(183, 107, 1);&quot;&gt;LambdaQueryWrapper&lt;/span&gt;&lt;span class=&quot;token generics&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;&amp;lt;&lt;/span&gt;&lt;span class=&quot;token generics&quot; style=&quot;color: rgb(183, 107, 1);&quot;&gt;User&lt;/span&gt;&lt;span class=&quot;token generics&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;&amp;gt;&lt;/span&gt;&lt;span&gt; wrapper &lt;/span&gt;&lt;span class=&quot;token&quot; style=&quot;color: rgb(64, 120, 242);&quot;&gt;=&lt;/span&gt;&lt;span&gt; &lt;/span&gt;&lt;span class=&quot;token&quot; style=&quot;color: rgb(166, 38, 164);&quot;&gt;new&lt;/span&gt;&lt;span&gt; &lt;/span&gt;&lt;span class=&quot;token&quot; style=&quot;color: rgb(183, 107, 1);&quot;&gt;LambdaQueryWrapper&lt;/span&gt;&lt;span class=&quot;token generics&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;&amp;lt;&lt;/span&gt;&lt;span class=&quot;token generics&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;&amp;gt;&lt;/span&gt;&lt;span class=&quot;token&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;(&lt;/span&gt;&lt;span class=&quot;token&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;)&lt;/span&gt;&lt;span class=&quot;token&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;;&lt;/span&gt;&lt;span&gt;&#xa;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&lt;span&gt;wrapper&lt;/span&gt;&lt;span class=&quot;token&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;.&lt;/span&gt;&lt;span class=&quot;token&quot; style=&quot;color: rgb(64, 120, 242);&quot;&gt;eq&lt;/span&gt;&lt;span class=&quot;token&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;(&lt;/span&gt;&lt;span class=&quot;token&quot; style=&quot;color: rgb(183, 107, 1);&quot;&gt;User&lt;/span&gt;&lt;span class=&quot;token&quot; style=&quot;color: rgb(64, 120, 242);&quot;&gt;::&lt;/span&gt;&lt;span class=&quot;token&quot; style=&quot;color: rgb(64, 120, 242);&quot;&gt;getUserName&lt;/span&gt;&lt;span class=&quot;token&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;,&lt;/span&gt;&lt;span&gt; &lt;/span&gt;&lt;span class=&quot;token&quot; style=&quot;color: rgb(80, 161, 79);&quot;&gt;&quot;张三&quot;&lt;/span&gt;&lt;span class=&quot;token&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;)&lt;/span&gt;&lt;span&gt;     &lt;/span&gt;&lt;span class=&quot;token&quot; style=&quot;color: rgb(160, 161, 167); font-style: italic;&quot;&gt;// 通过方法引用，不是字符串&lt;/span&gt;&lt;span&gt;&#xa;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&lt;span&gt;       &lt;/span&gt;&lt;span class=&quot;token&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;.&lt;/span&gt;&lt;span class=&quot;token&quot; style=&quot;color: rgb(64, 120, 242);&quot;&gt;gt&lt;/span&gt;&lt;span class=&quot;token&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;(&lt;/span&gt;&lt;span class=&quot;token&quot; style=&quot;color: rgb(183, 107, 1);&quot;&gt;User&lt;/span&gt;&lt;span class=&quot;token&quot; style=&quot;color: rgb(64, 120, 242);&quot;&gt;::&lt;/span&gt;&lt;span class=&quot;token&quot; style=&quot;color: rgb(64, 120, 242);&quot;&gt;getAge&lt;/span&gt;&lt;span class=&quot;token&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;,&lt;/span&gt;&lt;span&gt; &lt;/span&gt;&lt;span class=&quot;token&quot; style=&quot;color: rgb(183, 107, 1);&quot;&gt;18&lt;/span&gt;&lt;span class=&quot;token&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;)&lt;/span&gt;&lt;span&gt;             &lt;/span&gt;&lt;span class=&quot;token&quot; style=&quot;color: rgb(160, 161, 167); font-style: italic;&quot;&gt;// 通过方法引用&lt;/span&gt;&lt;span&gt;&#xa;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&lt;span&gt;       &lt;/span&gt;&lt;span class=&quot;token&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;.&lt;/span&gt;&lt;span class=&quot;token&quot; style=&quot;color: rgb(64, 120, 242);&quot;&gt;isNotNull&lt;/span&gt;&lt;span class=&quot;token&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;(&lt;/span&gt;&lt;span class=&quot;token&quot; style=&quot;color: rgb(183, 107, 1);&quot;&gt;User&lt;/span&gt;&lt;span class=&quot;token&quot; style=&quot;color: rgb(64, 120, 242);&quot;&gt;::&lt;/span&gt;&lt;span class=&quot;token&quot; style=&quot;color: rgb(64, 120, 242);&quot;&gt;getEmail&lt;/span&gt;&lt;span class=&quot;token&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;)&lt;/span&gt;&lt;span class=&quot;token&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;;&lt;/span&gt;&lt;span&gt;       &lt;/span&gt;&lt;span class=&quot;token&quot; style=&quot;color: rgb(160, 161, 167); font-style: italic;&quot;&gt;// 通过方法引用&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;" id="HzkJi81LxTetpSmTt199-1">
