; style=&quot;color: rgb(166, 38, 164);&quot;&gt;class&lt;/span&gt;&lt;span&gt; &lt;/span&gt;&lt;span class=&quot;token&quot; style=&quot;color: rgb(183, 107, 1);&quot;&gt;User&lt;/span&gt;&lt;span&gt; &lt;/span&gt;&lt;span class=&quot;token&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;{&lt;/span&gt;&lt;span&gt;&#xa;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&lt;span&gt;    &lt;/span&gt;&lt;span class=&quot;token&quot; style=&quot;color: rgb(166, 38, 164);&quot;&gt;private&lt;/span&gt;&lt;span&gt; &lt;/span&gt;&lt;span class=&quot;token&quot; style=&quot;color: rgb(183, 107, 1);&quot;&gt;Long&lt;/span&gt;&lt;span&gt; id&lt;/span&gt;&lt;span class=&quot;token&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;;&lt;/span&gt;&lt;span&gt;&#xa;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&lt;span&gt;    &lt;/span&gt;&lt;span class=&quot;token&quot; style=&quot;color: rgb(166, 38, 164);&quot;&gt;private&lt;/span&gt;&lt;span&gt; &lt;/span&gt;&lt;span class=&quot;token&quot; style=&quot;color: rgb(183, 107, 1);&quot;&gt;String&lt;/span&gt;&lt;span&gt; userName&lt;/span&gt;&lt;span class=&quot;token&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;;&lt;/span&gt;&lt;span&gt;&#xa;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&lt;span&gt;    &lt;/span&gt;&lt;span class=&quot;token&quot; style=&quot;color: rgb(166, 38, 164);&quot;&gt;private&lt;/span&gt;&lt;span&gt; &lt;/span&gt;&lt;span class=&quot;token&quot; style=&quot;color: rgb(183, 107, 1);&quot;&gt;Integer&lt;/span&gt;&lt;span&gt; age&lt;/span&gt;&lt;span class=&quot;token&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;;&lt;/span&gt;&lt;span&gt;&#xa;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&lt;span&gt;    &lt;/span&gt;&lt;span class=&quot;token&quot; style=&quot;color: rgb(166, 38, 164);&quot;&gt;private&lt;/span&gt;&lt;span&gt; &lt;/span&gt;&lt;span class=&quot;token&quot; style=&quot;color: rgb(183, 107, 1);&quot;&gt;String&lt;/span&gt;&lt;span&gt; email&lt;/span&gt;&lt;span class=&quot;token&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;;&lt;/span&gt;&lt;span&gt;&#xa;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&lt;span&gt;    &lt;/span&gt;&lt;span class=&quot;token&quot; style=&quot;color: rgb(160, 161, 167); font-style: italic;&quot;&gt;// getter/setter...&lt;/span&gt;&lt;span&gt;&#xa;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&lt;span&gt;&lt;/span&gt;&lt;span class=&quot;token&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;}&lt;/span&gt;&lt;span&gt;&#xa;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&#xa;&lt;/span&gt;&lt;span&gt;&lt;span&gt;&lt;/span&gt;&lt;span class=&quot;token&quot; style=&quot;color: rgb(160, 161, 167); font-style: italic;&quot;&gt;// 使用QueryWrapper - 硬编码字段名&lt;/span&gt;&lt;span&gt;&#xa;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&lt;span&gt;&lt;/span&gt;&lt;span class=&quot;token&quot; style=&quot;color: rgb(183, 107, 1);&quot;&gt;QueryWrapper&lt;/span&gt;&lt;span class=&quot;token generics&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;&amp;lt;&lt;/span&gt;&lt;span class=&quot;token generics&quot; style=&quot;color: rgb(183, 107, 1);&quot;&gt;User&lt;/span&gt;&lt;span class=&quot;token generics&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;&amp;gt;&lt;/span&gt;&lt;span&gt; wrapper &lt;/span&gt;&lt;span class=&quot;token&quot; style=&quot;color: rgb(64, 120, 242);&quot;&gt;=&lt;/span&gt;&lt;span&gt; &lt;/span&gt;&lt;span class=&quot;token&quot; style=&quot;color: rgb(166, 38, 164);&quot;&gt;new&lt;/span&gt;&lt;span&gt; &lt;/span&gt;&lt;span class=&quot;token&quot; style=&quot;color: rgb(183, 107, 1);&quot;&gt;QueryWrapper&lt;/span&gt;&lt;span class=&quot;token generics&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;&amp;lt;&lt;/span&gt;&lt;span class=&quot;token generics&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;&amp;gt;&lt;/span&gt;&lt;span class=&quot;token&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;(&lt;/span&gt;&lt;span class=&quot;token&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;)&lt;/span&gt;&lt;span class=&quot;token&quot; style=&quot;col