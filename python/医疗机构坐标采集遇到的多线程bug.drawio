style=&quot;color: #39adb5;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #39adb5;&quot;&gt;&#39;&lt;/span&gt;&lt;span style=&quot;color: #90a4ae;&quot;&gt;\n&lt;/span&gt;&lt;span style=&quot;color: #39adb5;&quot;&gt;&#39;&lt;/span&gt;&lt;span style=&quot;color: #39adb5;&quot;&gt;,&lt;/span&gt;&lt;span style=&quot;color: #6182b8;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: #39adb5;&quot;&gt;&#39;&#39;&lt;/span&gt;&lt;span style=&quot;color: #39adb5;&quot;&gt;).&lt;/span&gt;&lt;span style=&quot;color: #6182b8;&quot;&gt;strip&lt;/span&gt;&lt;span style=&quot;color: #39adb5;&quot;&gt;()&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #90a4ae;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: #6182b8;&quot;&gt;print&lt;/span&gt;&lt;span style=&quot;color: #39adb5;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #9c3eda;&quot;&gt;f&lt;/span&gt;&lt;span style=&quot;color: #91b859;&quot;&gt;&quot;多线程处理数据 &lt;/span&gt;&lt;span style=&quot;color: #f76d47;&quot;&gt;{&lt;/span&gt;&lt;span style=&quot;color: #90a4ae;&quot;&gt;idx&lt;/span&gt;&lt;span style=&quot;color: #f76d47;&quot;&gt;}&lt;/span&gt;&lt;span style=&quot;color: #91b859;&quot;&gt; 时发生错误: &lt;/span&gt;&lt;span style=&quot;color: #f76d47;&quot;&gt;{&lt;/span&gt;&lt;span style=&quot;color: #90a4ae;&quot;&gt;错误简要&lt;/span&gt;&lt;span style=&quot;color: #f76d47;&quot;&gt;}&lt;/span&gt;&lt;span style=&quot;color: #91b859;&quot;&gt;&quot;&lt;/span&gt;&lt;span style=&quot;color: #39adb5;&quot;&gt;)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #90a4ae;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: #90a4ae;&quot;&gt;results_with_idx&lt;/span&gt;&lt;span style=&quot;color: #39adb5;&quot;&gt;.&lt;/span&gt;&lt;span style=&quot;color: #6182b8;&quot;&gt;append&lt;/span&gt;&lt;span style=&quot;color: #39adb5;&quot;&gt;((&lt;/span&gt;&lt;span style=&quot;color: #90a4ae;&quot;&gt;idx&lt;/span&gt;&lt;span style=&quot;color: #39adb5;&quot;&gt;,&lt;/span&gt;&lt;span style=&quot;color: #6182b8;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: #39adb5;&quot;&gt;None&lt;/span&gt;&lt;span style=&quot;color: #39adb5;&quot;&gt;))&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;fontSize=18;" parent="1" vertex="1">
