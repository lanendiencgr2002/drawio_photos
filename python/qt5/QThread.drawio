        <mxCell id="NDUoAskK0zCty8ZlMkvZ-1" value="&lt;div style=&quot;color: #433748;background-color: #f5f2f9;font-family: Consolas, &#39;Courier New&#39;, monospace;font-weight: normal;font-size: 14px;line-height: 19px;white-space: pre;&quot;&gt;&lt;div&gt;&lt;span style=&quot;color: #c05386;&quot;&gt;# 示例&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #c05386;&quot;&gt;class&lt;/span&gt;&lt;span style=&quot;color: #433748;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: #b5855c;&quot;&gt;ProfileProcessWorker&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #b5855c;&quot;&gt;QThread&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;)&lt;/span&gt;&lt;span style=&quot;color: #433748;&quot;&gt;:&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;line-height: 19px;&quot;&gt;&lt;div&gt;&amp;nbsp; &lt;span style=&quot;color: #6b588e;&quot;&gt;log_signal&lt;/span&gt; &lt;span style=&quot;color: #c05386;&quot;&gt;=&lt;/span&gt; &lt;span style=&quot;color: #b5855c;&quot;&gt;pyqtSignal&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #b5855c;&quot;&gt;str&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &lt;span style=&quot;color: #6b588e;&quot;&gt;progress_signal&lt;/span&gt; &lt;span style=&quot;color: #c05386;&quot;&gt;=&lt;/span&gt; &lt;span style=&quot;color: #b5855c;&quot;&gt;pyqtSignal&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #b5855c;&quot;&gt;str&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;)&lt;/span&gt; &amp;nbsp;&lt;span style=&quot;color: #130718;&quot;&gt;# 进度信息&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &lt;span style=&quot;color: #6b588e;&quot;&gt;finished_signal&lt;/span&gt; &lt;span style=&quot;color: #c05386;&quot;&gt;=&lt;/span&gt; &lt;span style=&quot;color: #b5855c;&quot;&gt;pyqtSignal&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #b5855c;&quot;&gt;bool&lt;/span&gt;, &lt;span style=&quot;color: #b5855c;&quot;&gt;str&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;)&lt;/span&gt; &amp;nbsp;&lt;span style=&quot;color: #130718;&quot;&gt;# 完成状态(成功/失败)和消息&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;line-height: 19px;&quot;&gt;&lt;div&gt;&amp;nbsp; &lt;span style=&quot;color: #c05386;&quot;&gt;def&lt;/span&gt; &lt;span style=&quot;color: #668f9a;&quot;&gt;__init__&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #6b588e;&quot;&gt;self&lt;/span&gt;, &lt;span style=&quot;color: #6b588e;&quot;&gt;browser_id&lt;/span&gt;, &lt;span style=&quot;color: #6b588e;&quot;&gt;profile_url&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;)&lt;/span&gt;:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #b5855c;&quot;&gt;super&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;()&lt;/span&gt;.&lt;span style=&quot;color: #668f9a;&quot;&gt;__init__&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;()&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #6b588e;font-style: italic;&quot;&gt;self&lt;/span&gt;.&lt;span style=&quot;color: #6b588e;&quot;&gt;browser_id&lt;/span&gt; &lt;span style=&quot;color: #c05386;&quot;&gt;=&lt;/span&gt; &lt;span style=&quot;color: #6b588e;&quot;&gt;browser_id&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #6b588e;font-style: italic;&quot;&gt;self&lt;/span&gt;.&lt;span style=&quot;color: #6b588e;&quot;&gt;profile_url&lt;/span&gt; &lt;span style=&quot;color: #c05386;&quot;&gt;=&lt;/span&gt; &lt;span style=&quot;color: #6b588e;&quot;&gt;profile_url&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #6b588e;font-style: italic;&quot;&gt;self&lt;/span&gt;.&lt;span style=&quot;color: #6b588e;&quot;&gt;running&lt;/span&gt; &lt;span style=&quot;color: #c05386;&quot;&gt;=&lt;/span&gt; &lt;span style=&quot;color: #c7792b;&quot;&gt;True&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #130718;&quot;&gt;# 添加内部标志记录状态&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #6b588e;font-style: italic;&quot;&gt;self&lt;/span&gt;.&lt;span style=&quot;color: #6b588e;&quot;&gt;_error_flag&lt;/span&gt; &lt;span style=&quot;color: #c05386;&quot;&gt;=&lt;/span&gt; &lt;span style=&quot;color: #c7792b;&quot;&gt;False&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #6b588e;font-style: italic;&quot;&gt;self&lt;/span&gt;.&lt;span style=&quot;color: #6b588e;&quot;&gt;_error_message&lt;/span&gt; &lt;span style=&quot;color: #c05386;&quot;&gt;=&lt;/span&gt; &lt;span style=&quot;color: #377961;&quot;&gt;&quot;&quot;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #377961;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;fontSize=18;" parent="NDUoAskK0zCty8ZlMkvZ-5" vertex="1">
