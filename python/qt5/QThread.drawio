        </mxCell>
        <mxCell id="NDUoAskK0zCty8ZlMkvZ-4" value="&lt;div style=&quot;color: #433748;background-color: #f5f2f9;font-family: Consolas, &#39;Courier New&#39;, monospace;font-weight: normal;font-size: 14px;line-height: 19px;white-space: pre;&quot;&gt;&lt;div&gt;&lt;span style=&quot;color: #433748;&quot;&gt;&amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: #c05386;&quot;&gt;def&lt;/span&gt;&lt;span style=&quot;color: #433748;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: #668f9a;&quot;&gt;stop&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #6b588e;&quot;&gt;self&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;)&lt;/span&gt;&lt;span style=&quot;color: #433748;&quot;&gt;:&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #433748;&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;&quot;&quot;&quot;停止处理&quot;&quot;&quot;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #433748;&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: #6b588e;font-style: italic;&quot;&gt;self&lt;/span&gt;&lt;span style=&quot;color: #433748;&quot;&gt;.&lt;/span&gt;&lt;span style=&quot;color: #6b588e;&quot;&gt;running&lt;/span&gt;&lt;span style=&quot;color: #433748;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: #c05386;&quot;&gt;=&lt;/span&gt;&lt;span style=&quot;color: #433748;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;False&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #433748;&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: #6b588e;font-style: italic;&quot;&gt;self&lt;/span&gt;&lt;span style=&quot;color: #433748;&quot;&gt;.&lt;/span&gt;&lt;span style=&quot;color: #6b588e;&quot;&gt;log_signal&lt;/span&gt;&lt;span style=&quot;color: #433748;&quot;&gt;.&lt;/span&gt;&lt;span style=&quot;color: #668f9a;&quot;&gt;emit&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #c05386;&quot;&gt;f&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;&quot;正在停止任务: &lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;{&lt;/span&gt;&lt;span style=&quot;color: #6b588e;font-style: italic;&quot;&gt;self&lt;/span&gt;&lt;span style=&quot;color: #433748;&quot;&gt;.&lt;/span&gt;&lt;span style=&quot;color: #6b588e;&quot;&gt;profile_url&lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;}&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;&quot;&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #433748;&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;# 使用terminate()作为最后手段，如果线程在10秒内没有正常退出&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #433748;&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: #b5855c;&quot;&gt;QTimer&lt;/span&gt;&lt;span style=&quot;color: #433748;&quot;&gt;.&lt;/span&gt;&lt;span style=&quot;color: #668f9a;&quot;&gt;singleShot&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;10000&lt;/span&gt;&lt;span style=&quot;color: #433748;&quot;&gt;, &lt;/span&gt;&lt;span style=&quot;color: #6b588e;font-style: italic;&quot;&gt;self&lt;/span&gt;&lt;span style=&quot;color: #433748;&quot;&gt;.&lt;/span&gt;&lt;span style=&quot;color: #668f9a;&quot;&gt;terminate&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;)&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;fontSize=18;" parent="NDUoAskK0zCty8ZlMkvZ-5" vertex="1">
          <mxGeometry y="740" width="500" height="140" as="geometry" />
        </mxCell>
        <mxCell id="NDUoAskK0zCty8ZlMkvZ-6" value="定义" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=#d79b00;fillColor=#ffe6cc;fontSize=18;" parent="NDUoAskK0zCty8ZlMkvZ-7" vertex="1">
          <mxGeometry width="60" height="40" as="geometry" />
        </mxCell>
        <mxCell id="NDUoAskK0zCty8ZlMkvZ-8" value="&lt;div style=&quot;color: #433748;background-color: #f5f2f9;font-family: Consolas, &#39;Courier New&#39;, monospace;font-weight: normal;font-size: 14px;line-height: 19px;white-space: pre;&quot;&gt;&lt;div&gt;&lt;span style=&quot;color: #433748;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: #c05386;&quot;&gt;def&lt;/span&gt;&lt;span style=&quot;color: #433748;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: #668f9a;&quot;&gt;worker_thread&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #6b588e;&quot;&gt;account&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;)&lt;/span&gt;&lt;span style=&quot;color: #433748;&quot;&gt;:&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;line-height: 19px;&quot;&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #6b588e;&quot;&gt;account_id&lt;/span&gt; &lt;span style=&quot;color: #c05386;&quot;&gt;=&lt;/span&gt; &lt;span style=&quot;color: #6b588e;&quot;&gt;account&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;[&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;&quot;id&quot;&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;]&lt;/span&gt; &amp;nbsp;&lt;span style=&quot;color: #130718;&quot;&gt;# 当前账号ID&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #6b588e;&quot;&gt;browser_id&lt;/span&gt; &lt;span style=&quot;color: #c05386;&quot;&gt;=&lt;/span&gt; &lt;span style=&quot;color: #6b588e;&quot;&gt;account&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;[&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;&quot;browser_id&quot;&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;]&lt;/span&gt; &amp;nbsp;&lt;span style=&quot;color: #130718;&quot;&gt;# 账号对应的浏览器ID&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #6b588e;&quot;&gt;account_name&lt;/span&gt; &lt;span style=&quot;color: #c05386;&quot;&gt;=&lt;/span&gt; &lt;span style=&quot;color: #6b588e;&quot;&gt;account&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;[&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;&quot;name&quot;&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;]&lt;/span&gt; &amp;nbsp;&lt;span style=&quot;color: #130718;&quot;&gt;# 账号名称&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #6b588e;&quot;&gt;error_count&lt;/span&gt; &lt;span style=&quot;color: #c05386;&quot;&gt;=&lt;/span&gt; &lt;span style=&quot;color: #c7792b;&quot;&gt;0&lt;/span&gt; &amp;nbsp;&lt;span style=&quot;color: #130718;&quot;&gt;# 当前账号累计错误次数&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #6b588e;&quot;&gt;max_errors&lt;/span&gt; &lt;span style=&quot;color: #c05386;&quot;&gt;=&lt;/span&gt; &lt;span style=&quot;color: #c7792b;&quot;&gt;1&lt;/span&gt; &amp;nbsp;&lt;span style=&quot;color: #130718;&quot;&gt;# 最大允许错误次数&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;line-height: 19px;&quot;&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #c05386;&quot;&gt;def&lt;/span&gt; &lt;span style=&quot;color: #668f9a;&quot;&gt;update_ui_status&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #6b588e;&quot;&gt;status&lt;/span&gt;, &lt;span style=&quot;color: #6b588e;&quot;&gt;message&lt;/span&gt;&lt;span style=&quot;color: #c05386;&quot;&gt;=&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;&quot;&quot;&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;)&lt;/span&gt;:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #130718;&quot;&gt;# 通过信号发送到主线程处理&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #6b588e;font-style: italic;&quot;&gt;self&lt;/span&gt;.&lt;span style=&quot;color: #6b588e;&quot;&gt;status_update_signal&lt;/span&gt;.&lt;span style=&quot;color: #668f9a;&quot;&gt;emit&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #6b588e;&quot;&gt;account_id&lt;/span&gt;, &lt;span style=&quot;color: #6b588e;&quot;&gt;status&lt;/span&gt;, &lt;span style=&quot;color: #6b588e;&quot;&gt;message&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #130718;&quot;&gt;# 启动时将账号状态设为running&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #668f9a;&quot;&gt;update_ui_status&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;&quot;running&quot;&lt;/span&gt;, &lt;span style=&quot;color: #c05386;&quot;&gt;f&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;&quot;账号 &#39;&lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;{&lt;/span&gt;&lt;span style=&quot;color: #6b588e;&quot;&gt;account_name&lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;}&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;&#39; 开始批量处理任务&quot;&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #130718;&quot;&gt;# 主循环：不断从队列取URL处理，直到队列空或账号被移除&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #c05386;&quot;&gt;while&lt;/span&gt; &lt;span style=&quot;color: #c05386;&quot;&gt;not&lt;/span&gt; &lt;span style=&quot;color: #6b588e;&quot;&gt;url_queue&lt;/span&gt;.&lt;span style=&quot;color: #668f9a;&quot;&gt;empty&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;()&lt;/span&gt; &lt;span style=&quot;color: #c05386;&quot;&gt;and&lt;/span&gt; &lt;span style=&quot;color: #6b588e;&quot;&gt;account_id&lt;/span&gt; &lt;span style=&quot;color: #c05386;&quot;&gt;in&lt;/span&gt; &lt;span style=&quot;color: #6b588e;&quot;&gt;active_threads&lt;/span&gt;:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #c05386;&quot;&gt;try&lt;/span&gt;:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #130718;&quot;&gt;# 若错误次数超限，账号被标记为异常并退出循环&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #c05386;&quot;&gt;if&lt;/span&gt; &lt;span style=&quot;color: #6b588e;&quot;&gt;error_count&lt;/span&gt; &lt;span style=&quot;color: #c05386;&quot;&gt;&amp;gt;=&lt;/span&gt; &lt;span style=&quot;color: #6b588e;&quot;&gt;max_errors&lt;/span&gt;:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #668f9a;&quot;&gt;update_ui_status&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;&quot;error&quot;&lt;/span&gt;, &lt;span style=&quot;color: #c05386;&quot;&gt;f&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;&quot;账号 &#39;&lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;{&lt;/span&gt;&lt;span style=&quot;color: #6b588e;&quot;&gt;account_name&lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;}&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;&#39; 连续出错 &lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;{&lt;/span&gt;&lt;span style=&quot;color: #6b588e;&quot;&gt;max_errors&lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;}&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt; 次，被标记为异常状态&quot;&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #6b588e;&quot;&gt;logger&lt;/span&gt;.&lt;span style=&quot;color: #668f9a;&quot;&gt;error&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #c05386;&quot;&gt;f&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;&quot;账号 &#39;&lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;{&lt;/span&gt;&lt;span style=&quot;color: #6b588e;&quot;&gt;account_name&lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;}&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;&#39; 连续出错 &lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;{&lt;/span&gt;&lt;span style=&quot;color: #6b588e;&quot;&gt;max_errors&lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;}&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt; 次，停止后续任务处理&quot;&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #c05386;&quot;&gt;if&lt;/span&gt; &lt;span style=&quot;color: #6b588e;&quot;&gt;account_id&lt;/span&gt; &lt;span style=&quot;color: #c05386;&quot;&gt;in&lt;/span&gt; &lt;span style=&quot;color: #6b588e;&quot;&gt;active_threads&lt;/span&gt;:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #c05386;&quot;&gt;del&lt;/span&gt; &lt;span style=&quot;color: #6b588e;&quot;&gt;active_threads&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;[&lt;/span&gt;&lt;span style=&quot;color: #6b588e;&quot;&gt;account_id&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;]&lt;/span&gt; &amp;nbsp;&lt;span style=&quot;color: #130718;&quot;&gt;# 移除活动线程，终止循环&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #c05386;&quot;&gt;break&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #130718;&quot;&gt;# 非阻塞方式从队列获取一个URL任务&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #c05386;&quot;&gt;try&lt;/span&gt;:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #6b588e;&quot;&gt;profile_url&lt;/span&gt; &lt;span style=&quot;color: #c05386;&quot;&gt;=&lt;/span&gt; &lt;span style=&quot;color: #6b588e;&quot;&gt;url_queue&lt;/span&gt;.&lt;span style=&quot;color: #668f9a;&quot;&gt;get&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #6b588e;&quot;&gt;block&lt;/span&gt;&lt;span style=&quot;color: #c05386;&quot;&gt;=&lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;False&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;)&lt;/span&gt; &amp;nbsp;&lt;span style=&quot;color: #130718;&quot;&gt;# 若队列空则抛出异常&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #c05386;&quot;&gt;except&lt;/span&gt; &lt;span style=&quot;color: #b5855c;&quot;&gt;queue&lt;/span&gt;.&lt;span style=&quot;color: #b5855c;&quot;&gt;Empty&lt;/span&gt;:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #c05386;&quot;&gt;break&lt;/span&gt; &amp;nbsp;&lt;span style=&quot;color: #130718;&quot;&gt;# 队列已空，退出循环&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #130718;&quot;&gt;# 更新账号状态为running，并显示当前处理的URL&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #668f9a;&quot;&gt;update_ui_status&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;&quot;running&quot;&lt;/span&gt;, &lt;span style=&quot;color: #c05386;&quot;&gt;f&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;&quot;账号 &#39;&lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;{&lt;/span&gt;&lt;span style=&quot;color: #6b588e;&quot;&gt;account_name&lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;}&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;&#39; 正在处理: &lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;{&lt;/span&gt;&lt;span style=&quot;color: #6b588e;&quot;&gt;profile_url&lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;}&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;&quot;&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #130718;&quot;&gt;# 先定义处理完成后的回调函数&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #c05386;&quot;&gt;def&lt;/span&gt; &lt;span style=&quot;color: #668f9a;&quot;&gt;handle_finished&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #6b588e;&quot;&gt;success&lt;/span&gt;, &lt;span style=&quot;color: #6b588e;&quot;&gt;msg&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;)&lt;/span&gt;:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #668f9a;&quot;&gt;print&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;&#39;处理完成的回调函数！！&#39;&lt;/span&gt;,&lt;span style=&quot;color: #6b588e;&quot;&gt;success&lt;/span&gt;,&lt;span style=&quot;color: #6b588e;&quot;&gt;msg&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #c05386;&quot;&gt;nonlocal&lt;/span&gt; &lt;span style=&quot;color: #6b588e;&quot;&gt;error_count&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #c05386;&quot;&gt;if&lt;/span&gt; &lt;span style=&quot;color: #6b588e;&quot;&gt;success&lt;/span&gt;:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #130718;&quot;&gt;# 处理成功，重置错误计数&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #6b588e;&quot;&gt;logger&lt;/span&gt;.&lt;span style=&quot;color: #668f9a;&quot;&gt;info&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #c05386;&quot;&gt;f&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;&quot;[&lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;{&lt;/span&gt;&lt;span style=&quot;color: #6b588e;&quot;&gt;account_name&lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;}&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;] 处理成功: &lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;{&lt;/span&gt;&lt;span style=&quot;color: #6b588e;&quot;&gt;msg&lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;}&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;&quot;&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #6b588e;&quot;&gt;error_count&lt;/span&gt; &lt;span style=&quot;color: #c05386;&quot;&gt;=&lt;/span&gt; &lt;span style=&quot;color: #c7792b;&quot;&gt;0&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #c05386;&quot;&gt;else&lt;/span&gt;:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #130718;&quot;&gt;# 处理失败，增加错误计数并判断是否严重异常&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #6b588e;&quot;&gt;logger&lt;/span&gt;.&lt;span style=&quot;color: #668f9a;&quot;&gt;error&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #c05386;&quot;&gt;f&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;&quot;[&lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;{&lt;/span&gt;&lt;span style=&quot;color: #6b588e;&quot;&gt;account_name&lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;}&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;] 处理失败: &lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;{&lt;/span&gt;&lt;span style=&quot;color: #6b588e;&quot;&gt;msg&lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;}&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;&quot;&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #6b588e;&quot;&gt;error_count&lt;/span&gt; &lt;span style=&quot;color: #c05386;&quot;&gt;+=&lt;/span&gt; &lt;span style=&quot;color: #c7792b;&quot;&gt;1&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #6b588e;&quot;&gt;logger&lt;/span&gt;.&lt;span style=&quot;color: #668f9a;&quot;&gt;warning&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #c05386;&quot;&gt;f&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;&quot;账号 &#39;&lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;{&lt;/span&gt;&lt;span style=&quot;color: #6b588e;&quot;&gt;account_name&lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;}&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;&#39; 出现错误，当前错误次数: &lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;{&lt;/span&gt;&lt;span style=&quot;color: #6b588e;&quot;&gt;error_count&lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;}&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;/&lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;{&lt;/span&gt;&lt;span style=&quot;color: #6b588e;&quot;&gt;max_errors&lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;}&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;&quot;&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #668f9a;&quot;&gt;update_ui_status&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;&quot;error&quot;&lt;/span&gt;, &lt;span style=&quot;color: #c05386;&quot;&gt;f&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;&quot;账号 &#39;&lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;{&lt;/span&gt;&lt;span style=&quot;color: #6b588e;&quot;&gt;account_name&lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;}&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;&#39; 出现异常: &lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;{&lt;/span&gt;&lt;span style=&quot;color: #6b588e;&quot;&gt;msg&lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;}&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;&quot;&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #c05386;&quot;&gt;try&lt;/span&gt;:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #6b588e;&quot;&gt;logger&lt;/span&gt;.&lt;span style=&quot;color: #668f9a;&quot;&gt;info&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #c05386;&quot;&gt;f&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;&quot;将URL &#39;&lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;{&lt;/span&gt;&lt;span style=&quot;color: #6b588e;&quot;&gt;profile_url&lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;}&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;&#39; 放回处理队列&quot;&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #6b588e;&quot;&gt;url_queue&lt;/span&gt;.&lt;span style=&quot;color: #668f9a;&quot;&gt;put&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #6b588e;&quot;&gt;profile_url&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;)&lt;/span&gt; &amp;nbsp;&lt;span style=&quot;color: #130718;&quot;&gt;# 失败的URL重新入队&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #c05386;&quot;&gt;except&lt;/span&gt; &lt;span style=&quot;color: #b5855c;&quot;&gt;Exception&lt;/span&gt; &lt;span style=&quot;color: #c05386;&quot;&gt;as&lt;/span&gt; &lt;span style=&quot;color: #6b588e;&quot;&gt;put_error&lt;/span&gt;:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #6b588e;&quot;&gt;logger&lt;/span&gt;.&lt;span style=&quot;color: #668f9a;&quot;&gt;error&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #c05386;&quot;&gt;f&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;&quot;放回URL到队列时出错: &lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;{&lt;/span&gt;&lt;span style=&quot;color: #b5855c;&quot;&gt;str&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #6b588e;&quot;&gt;put_error&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;)&lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;}&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;&quot;&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #c05386;&quot;&gt;if&lt;/span&gt; &lt;span style=&quot;color: #6b588e;&quot;&gt;account_id&lt;/span&gt; &lt;span style=&quot;color: #c05386;&quot;&gt;in&lt;/span&gt; &lt;span style=&quot;color: #6b588e;&quot;&gt;active_threads&lt;/span&gt;:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #6b588e;&quot;&gt;logger&lt;/span&gt;.&lt;span style=&quot;color: #668f9a;&quot;&gt;error&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #c05386;&quot;&gt;f&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;&quot;账号 &#39;&lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;{&lt;/span&gt;&lt;span style=&quot;color: #6b588e;&quot;&gt;account_name&lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;}&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;&#39; 被标记为异常状态，停止后续任务处理&quot;&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #c05386;&quot;&gt;del&lt;/span&gt; &lt;span style=&quot;color: #6b588e;&quot;&gt;active_threads&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;[&lt;/span&gt;&lt;span style=&quot;color: #6b588e;&quot;&gt;account_id&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;]&lt;/span&gt; &amp;nbsp;&lt;span style=&quot;color: #130718;&quot;&gt;# 移除活动线程&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #c05386;&quot;&gt;return&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #130718;&quot;&gt;# 创建处理worker线程，负责处理单个profile_url&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #6b588e;&quot;&gt;process_worker&lt;/span&gt; &lt;span style=&quot;color: #c05386;&quot;&gt;=&lt;/span&gt; &lt;span style=&quot;color: #b5855c;&quot;&gt;ProfileProcessWorker&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #6b588e;&quot;&gt;browser_id&lt;/span&gt;, &lt;span style=&quot;color: #6b588e;&quot;&gt;profile_url&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #130718;&quot;&gt;# 连接worker的信号到日志输出&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #6b588e;&quot;&gt;process_worker&lt;/span&gt;.&lt;span style=&quot;color: #6b588e;&quot;&gt;log_signal&lt;/span&gt;.&lt;span style=&quot;color: #668f9a;&quot;&gt;connect&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #c05386;&quot;&gt;lambda&lt;/span&gt; &lt;span style=&quot;color: #6b588e;&quot;&gt;msg&lt;/span&gt;: &lt;span style=&quot;color: #6b588e;&quot;&gt;logger&lt;/span&gt;.&lt;span style=&quot;color: #668f9a;&quot;&gt;info&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #c05386;&quot;&gt;f&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;&quot;[&lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;{&lt;/span&gt;&lt;span style=&quot;color: #6b588e;&quot;&gt;account_name&lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;}&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;] &lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;{&lt;/span&gt;&lt;span style=&quot;color: #6b588e;&quot;&gt;msg&lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;}&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;&quot;&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;))&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #6b588e;&quot;&gt;process_worker&lt;/span&gt;.&lt;span style=&quot;color: #6b588e;&quot;&gt;progress_signal&lt;/span&gt;.&lt;span style=&quot;color: #668f9a;&quot;&gt;connect&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #c05386;&quot;&gt;lambda&lt;/span&gt; &lt;span style=&quot;color: #6b588e;&quot;&gt;msg&lt;/span&gt;: &lt;span style=&quot;color: #6b588e;&quot;&gt;logger&lt;/span&gt;.&lt;span style=&quot;color: #668f9a;&quot;&gt;info&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #c05386;&quot;&gt;f&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;&quot;[&lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;{&lt;/span&gt;&lt;span style=&quot;color: #6b588e;&quot;&gt;account_name&lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;}&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;] &lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;{&lt;/span&gt;&lt;span style=&quot;color: #6b588e;&quot;&gt;msg&lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;}&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;&quot;&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;))&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #130718;&quot;&gt;# 处理完成信号，回调handle_finished，使用队列连接确保在主线程处理&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #6b588e;&quot;&gt;process_worker&lt;/span&gt;.&lt;span style=&quot;color: #6b588e;&quot;&gt;finished_signal&lt;/span&gt;.&lt;span style=&quot;color: #668f9a;&quot;&gt;connect&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #668f9a;&quot;&gt;handle_finished&lt;/span&gt;, &lt;span style=&quot;color: #b5855c;&quot;&gt;Qt&lt;/span&gt;.DirectConnection&lt;span style=&quot;color: #130718;&quot;&gt;)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #130718;&quot;&gt;# 将worker加入活跃worker列表&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #6b588e;&quot;&gt;active_workers&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;[&lt;/span&gt;&lt;span style=&quot;color: #6b588e;&quot;&gt;account_id&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;]&lt;/span&gt;.append&lt;span style=&quot;color: #130718;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #6b588e;&quot;&gt;process_worker&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #130718;&quot;&gt;# 启动worker线程&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #6b588e;&quot;&gt;process_worker&lt;/span&gt;.&lt;span style=&quot;color: #668f9a;&quot;&gt;start&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;()&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #130718;&quot;&gt;# 等待worker处理完成，期间不断处理UI事件，避免界面卡死&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #c05386;&quot;&gt;while&lt;/span&gt; &lt;span style=&quot;color: #6b588e;&quot;&gt;process_worker&lt;/span&gt;.&lt;span style=&quot;color: #668f9a;&quot;&gt;isRunning&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;()&lt;/span&gt; &lt;span style=&quot;color: #c05386;&quot;&gt;and&lt;/span&gt; &lt;span style=&quot;color: #6b588e;&quot;&gt;account_id&lt;/span&gt; &lt;span style=&quot;color: #c05386;&quot;&gt;in&lt;/span&gt; &lt;span style=&quot;color: #6b588e;&quot;&gt;active_threads&lt;/span&gt;:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #c05386;&quot;&gt;try&lt;/span&gt;:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #b5855c;&quot;&gt;QApplication&lt;/span&gt;.&lt;span style=&quot;color: #668f9a;&quot;&gt;processEvents&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;()&lt;/span&gt; &amp;nbsp;&lt;span style=&quot;color: #130718;&quot;&gt;# 处理UI事件，保持界面响应&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #b5855c;&quot;&gt;time&lt;/span&gt;.&lt;span style=&quot;color: #668f9a;&quot;&gt;sleep&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;0.1&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;)&lt;/span&gt; &amp;nbsp;&lt;span style=&quot;color: #130718;&quot;&gt;# 短暂休眠，降低CPU占用&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #c05386;&quot;&gt;except&lt;/span&gt; &lt;span style=&quot;color: #b5855c;&quot;&gt;Exception&lt;/span&gt; &lt;span style=&quot;color: #c05386;&quot;&gt;as&lt;/span&gt; &lt;span style=&quot;color: #6b588e;&quot;&gt;e&lt;/span&gt;:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #130718;&quot;&gt;# 等待期间发生异常，账号标记为异常，URL回队&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #6b588e;&quot;&gt;logger&lt;/span&gt;.&lt;span style=&quot;color: #668f9a;&quot;&gt;error&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #c05386;&quot;&gt;f&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;&quot;账号 &#39;&lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;{&lt;/span&gt;&lt;span style=&quot;color: #6b588e;&quot;&gt;account_name&lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;}&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;&#39; 处理等待时出错: &lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;{&lt;/span&gt;&lt;span style=&quot;color: #b5855c;&quot;&gt;str&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #6b588e;&quot;&gt;e&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;)&lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;}&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;&quot;&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #668f9a;&quot;&gt;update_ui_status&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;&quot;error&quot;&lt;/span&gt;, &lt;span style=&quot;color: #c05386;&quot;&gt;f&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;&quot;账号 &#39;&lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;{&lt;/span&gt;&lt;span style=&quot;color: #6b588e;&quot;&gt;account_name&lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;}&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;&#39; 处理等待时出错: &lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;{&lt;/span&gt;&lt;span style=&quot;color: #b5855c;&quot;&gt;str&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #6b588e;&quot;&gt;e&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;)&lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;}&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;&quot;&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #c05386;&quot;&gt;try&lt;/span&gt;:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #6b588e;&quot;&gt;logger&lt;/span&gt;.&lt;span style=&quot;color: #668f9a;&quot;&gt;info&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #c05386;&quot;&gt;f&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;&quot;将URL &#39;&lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;{&lt;/span&gt;&lt;span style=&quot;color: #6b588e;&quot;&gt;profile_url&lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;}&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;&#39; 放回处理队列&quot;&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #6b588e;&quot;&gt;url_queue&lt;/span&gt;.&lt;span style=&quot;color: #668f9a;&quot;&gt;put&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #6b588e;&quot;&gt;profile_url&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #c05386;&quot;&gt;except&lt;/span&gt; &lt;span style=&quot;color: #b5855c;&quot;&gt;Exception&lt;/span&gt; &lt;span style=&quot;color: #c05386;&quot;&gt;as&lt;/span&gt; &lt;span style=&quot;color: #6b588e;&quot;&gt;put_error&lt;/span&gt;:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #6b588e;&quot;&gt;logger&lt;/span&gt;.&lt;span style=&quot;color: #668f9a;&quot;&gt;error&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #c05386;&quot;&gt;f&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;&quot;放回URL到队列时出错: &lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;{&lt;/span&gt;&lt;span style=&quot;color: #b5855c;&quot;&gt;str&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #6b588e;&quot;&gt;put_error&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;)&lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;}&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;&quot;&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #6b588e;&quot;&gt;process_worker&lt;/span&gt;.&lt;span style=&quot;color: #668f9a;&quot;&gt;stop&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;()&lt;/span&gt; &amp;nbsp;&lt;span style=&quot;color: #130718;&quot;&gt;# 停止worker&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #c05386;&quot;&gt;if&lt;/span&gt; &lt;span style=&quot;color: #6b588e;&quot;&gt;process_worker&lt;/span&gt; &lt;span style=&quot;color: #c05386;&quot;&gt;in&lt;/span&gt; &lt;span style=&quot;color: #6b588e;&quot;&gt;active_workers&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;[&lt;/span&gt;&lt;span style=&quot;color: #6b588e;&quot;&gt;account_id&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;]&lt;/span&gt;:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #6b588e;&quot;&gt;active_workers&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;[&lt;/span&gt;&lt;span style=&quot;color: #6b588e;&quot;&gt;account_id&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;]&lt;/span&gt;.remove&lt;span style=&quot;color: #130718;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #6b588e;&quot;&gt;process_worker&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #c05386;&quot;&gt;if&lt;/span&gt; &lt;span style=&quot;color: #6b588e;&quot;&gt;account_id&lt;/span&gt; &lt;span style=&quot;color: #c05386;&quot;&gt;in&lt;/span&gt; &lt;span style=&quot;color: #6b588e;&quot;&gt;active_threads&lt;/span&gt;:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #c05386;&quot;&gt;del&lt;/span&gt; &lt;span style=&quot;color: #6b588e;&quot;&gt;active_threads&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;[&lt;/span&gt;&lt;span style=&quot;color: #6b588e;&quot;&gt;account_id&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;]&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #c05386;&quot;&gt;break&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #130718;&quot;&gt;# 若账号已被移除（如被批量停止），则终止本次处理并回收URL&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #c05386;&quot;&gt;if&lt;/span&gt; &lt;span style=&quot;color: #6b588e;&quot;&gt;account_id&lt;/span&gt; &lt;span style=&quot;color: #c05386;&quot;&gt;not&lt;/span&gt; &lt;span style=&quot;color: #c05386;&quot;&gt;in&lt;/span&gt; &lt;span style=&quot;color: #6b588e;&quot;&gt;active_threads&lt;/span&gt;:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #6b588e;&quot;&gt;process_worker&lt;/span&gt;.&lt;span style=&quot;color: #668f9a;&quot;&gt;stop&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;()&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #6b588e;&quot;&gt;url_queue&lt;/span&gt;.&lt;span style=&quot;color: #668f9a;&quot;&gt;put&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #6b588e;&quot;&gt;profile_url&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;)&lt;/span&gt; &amp;nbsp;&lt;span style=&quot;color: #130718;&quot;&gt;# 任务回队，供其他账号处理&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #c05386;&quot;&gt;break&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #130718;&quot;&gt;# 处理完成后，从活跃worker列表移除&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #c05386;&quot;&gt;if&lt;/span&gt; &lt;span style=&quot;color: #6b588e;&quot;&gt;process_worker&lt;/span&gt; &lt;span style=&quot;color: #c05386;&quot;&gt;in&lt;/span&gt; &lt;span style=&quot;color: #6b588e;&quot;&gt;active_workers&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;[&lt;/span&gt;&lt;span style=&quot;color: #6b588e;&quot;&gt;account_id&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;]&lt;/span&gt;:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #6b588e;&quot;&gt;active_workers&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;[&lt;/span&gt;&lt;span style=&quot;color: #6b588e;&quot;&gt;account_id&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;]&lt;/span&gt;.remove&lt;span style=&quot;color: #130718;&quot;&gt;(&lt;/span&gt;&lt;span style=&