pan style=&quot;color: #130718;&quot;&gt;()&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #c05386;&quot;&gt;if&lt;/span&gt; &lt;span style=&quot;color: #6b588e;&quot;&gt;process_worker&lt;/span&gt; &lt;span style=&quot;color: #c05386;&quot;&gt;in&lt;/span&gt; &lt;span style=&quot;color: #6b588e;&quot;&gt;active_workers&lt;/span&gt;.&lt;span style=&quot;color: #668f9a;&quot;&gt;get&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #6b588e;&quot;&gt;account_id&lt;/span&gt;, &lt;span style=&quot;color: #130718;&quot;&gt;[])&lt;/span&gt;:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #6b588e;&quot;&gt;active_workers&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;[&lt;/span&gt;&lt;span style=&quot;color: #6b588e;&quot;&gt;account_id&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;]&lt;/span&gt;.remove&lt;span style=&quot;color: #130718;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #6b588e;&quot;&gt;process_worker&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #c05386;&quot;&gt;except&lt;/span&gt; &lt;span style=&quot;color: #b5855c;&quot;&gt;Exception&lt;/span&gt; &lt;span style=&quot;color: #c05386;&quot;&gt;as&lt;/span&gt; &lt;span style=&quot;color: #6b588e;&quot;&gt;stop_error&lt;/span&gt;:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #6b588e;&quot;&gt;logger&lt;/span&gt;.&lt;span style=&quot;color: #668f9a;&quot;&gt;error&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #c05386;&quot;&gt;f&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;&quot;停止处理线程时出错: &lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;{&lt;/span&gt;&lt;span style=&quot;color: #b5855c;&quot;&gt;str&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #6b588e;&quot;&gt;stop_error&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;)&lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;}&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;&quot;&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #130718;&quot;&gt;# 若错误超限或为严重异常，账号直接标记为异常并终止&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #c05386;&quot;&gt;if&lt;/span&gt; &lt;span style=&quot;color: #6b588e;&quot;&gt;error_count&lt;/span&gt; &lt;span style=&quot;color: #c05386;&quot;&gt;&amp;gt;=&lt;/span&gt; &lt;span style=&quot;color: #6b588e;&quot;&gt;max_errors&lt;/span&gt; &lt;span style=&quot;color: #c05386;&quot;&gt;or&lt;/span&gt; &lt;span style=&quot;color: #377961;&quot;&gt;&quot;浏览器连接失败&quot;&lt;/span&gt; &lt;span style=&quot;color: #c05386;&quot;&gt;in&lt;/span&gt; &lt;span style=&quot;color: #6b588e;&quot;&gt;error_msg&lt;/span&gt; &lt;span style=&quot;color: #c05386;&quot;&gt;or&lt;/span&gt; &lt;span style=&quot;color: #377961;&quot;&gt;&quot;登录&quot;&lt;/span&gt; &lt;span style=&quot;color: #c05386;&quot;&gt;in&lt;/span&gt; &lt;span style=&quot;color: #6b588e;&quot;&gt;error_msg&lt;/span&gt; &lt;span style=&quot;color: #c05386;&quot;&gt;or&lt;/span&gt; &lt;span style=&quot;color: #377961;&quot;&gt;&quot;无法访问&quot;&lt;/span&gt; &lt;span style=&quot;color: #c05386;&quot;&gt;in&lt;/span&gt; &lt;span style=&quot;color: #6b588e;&quot;&gt;error_msg&lt;/span&gt;:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #668f9a;&quot;&gt;update_ui_status&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;&quot;error&quot;&lt;/span&gt;, &lt;span style=&quot;color: #c05386;&quot;&gt;f&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;&quot;账号 &#39;&lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;{&lt;/span&gt;&lt;span style=&quot;color: #6b588e;&quot;&gt;account_name&lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;}&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;&#39; 出现严重异常: &lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;{&lt;/span&gt;&lt;span style=&quot;color: #6b588e;&quot;&gt;error_msg&lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;}&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;&quot;&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #6b588e;&quot;&gt;logger&lt;/span&gt;.&lt;span style=&quot;color: #668f9a;&quot;&gt;error&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #c05386;&quot;&gt;f&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;&quot;账号 &#39;&lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;{&lt;/span&gt;&lt;span style=&quot;color: #6b588e;&quot;&gt;account_name&lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;}&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;&#39; 被标记为异常状态，停止后续任务处理&quot;&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #c05386;&quot;&gt;if&lt;/span&gt; &lt;span style=&quot;color: #6b588e;&quot;&gt;account_id&lt;/span&gt; &lt;span style=&quot;color: #c05386;&quot;&gt;in&lt;/span&gt;