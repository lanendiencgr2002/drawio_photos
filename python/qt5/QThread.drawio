yle=&quot;color: #c05386;&quot;&gt;f&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;&quot;账号 &#39;&lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;{&lt;/span&gt;&lt;span style=&quot;color: #6b588e;&quot;&gt;account_name&lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;}&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;&#39; 处理任务时出错: &lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;{&lt;/span&gt;&lt;span style=&quot;color: #6b588e;&quot;&gt;error_msg&lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;}&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;&quot;&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #6b588e;&quot;&gt;error_count&lt;/span&gt; &lt;span style=&quot;color: #c05386;&quot;&gt;+=&lt;/span&gt; &lt;span style=&quot;color: #c7792b;&quot;&gt;1&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #6b588e;&quot;&gt;logger&lt;/span&gt;.&lt;span style=&quot;color: #668f9a;&quot;&gt;warning&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #c05386;&quot;&gt;f&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;&quot;账号 &#39;&lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;{&lt;/span&gt;&lt;span style=&quot;color: #6b588e;&quot;&gt;account_name&lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;}&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;&#39; 出现错误，当前错误次数: &lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;{&lt;/span&gt;&lt;span style=&quot;color: #6b588e;&quot;&gt;error_count&lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;}&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;/&lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;{&lt;/span&gt;&lt;span style=&quot;colo