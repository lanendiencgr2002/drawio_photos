0be7d;&quot;&gt;] &lt;/span&gt;&lt;span style=&quot;color: #a0c8ff;&quot;&gt;{&lt;/span&gt;&lt;span style=&quot;color: #9696ff;&quot;&gt;msg&lt;/span&gt;&lt;span style=&quot;color: #a0c8ff;&quot;&gt;}&lt;/span&gt;&lt;span style=&quot;color: #a0be7d;&quot;&gt;&quot;&lt;/span&gt;&lt;span style=&quot;color: #b4dcf0;&quot;&gt;))&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #f0f0f0;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: #8c8c8c;&quot;&gt;# 处理完成信号，回调handle_finished，使用队列连接确保在主线程处理&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #f0f0f0;&quot;&gt;&amp;nbsp; &amp;nbsp;process_worker&lt;/span&gt;&lt;span style=&quot;color: #d7d7d7;&quot;&gt;.&lt;/span&gt;&lt;span style=&quot;color: #f0f0f0;&quot;&gt;finished_signal&lt;/span&gt;&lt;span style=&quot;color: #d7d7d7;&quot;&gt;.&lt;/span&gt;&lt;span style=&quot;color: #3cbeff;&quot;&gt;connect&lt;/span&gt;&lt;span style=&quot;color: #b4dcf0;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #9696ff;&quot;&gt;handle_finished&lt;/span&gt;&lt;span style=&quot;color: #d7d7d7;&quot;&gt;,&lt;/span&gt;&lt;span style=&quot;color: #9696ff;&quot;&gt; Qt&lt;/span&gt;&lt;span style=&quot;color: #d7d7d7;&quot;&gt;.&lt;/span&gt;&lt;span style=&quot;color: #9696ff;&quot;&gt;DirectConnection&lt;/span&gt;&lt;span style=&quot;color: #b4dcf0;&quot;&gt;)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #f0f0f0;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;fontSize=18;" parent="1" vertex="1">
