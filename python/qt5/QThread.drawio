        <mxCell id="tUVzWTP75uRMthoa1BVd-1" value="&lt;div style=&quot;color: #f0f0f0;background-color: #191919;font-family: Consolas, &#39;Courier New&#39;, monospace;font-weight: normal;font-size: 14px;line-height: 19px;white-space: pre;&quot;&gt;&lt;div style=&quot;line-height: 19px;&quot;&gt;&lt;div&gt;&lt;span style=&quot;color: #8c8c8c;&quot;&gt;# 创建处理worker线程，负责处理单个profile_url&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp;process_worker &lt;span style=&quot;color: rgb(120, 210, 255);&quot;&gt;=&lt;/span&gt; &lt;span style=&quot;color: rgb(60, 190, 255);&quot;&gt;ProfileProcessWorker&lt;/span&gt;&lt;span style=&quot;color: rgb(180, 220, 240);&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: rgb(150, 150, 255);&quot;&gt;browser_id&lt;/span&gt;&lt;span style=&quot;color: rgb(215, 215, 215);&quot;&gt;,&lt;/span&gt;&lt;span style=&quot;color: rgb(150, 150, 255);&quot;&gt; profile_url&lt;/span&gt;&lt;span style=&quot;color: rgb(180, 220, 240);&quot;&gt;)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #8c8c8c;&quot;&gt;# 连接worker的信号到日志输出&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #f0f0f0;&quot;&gt;&amp;nbsp; &amp;nbsp;process_worker&lt;/span&gt;&lt;span style=&quot;color: #d7d7d7;&quot;&gt;.&lt;/span&gt;&lt;span style=&quot;color: #f0f0f0;&quot;&gt;log_signal&lt;/span&gt;&lt;span style=&quot;color: #d7d7d7;&quot;&gt;.&lt;/span&gt;&lt;span style=&quot;color: #3cbeff;&quot;&gt;connect&lt;/span&gt;&lt;span style=&quot;color: #b4dcf0;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #e1a0ff;&quot;&gt;lambda&lt;/span&gt;&lt;span style=&quot;color: #b4dcf0;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: #78b4ff;&quot;&gt;msg&lt;/span&gt;&lt;span style=&quot;color: #b4dcf0;&quot;&gt;:&lt;/span&gt;&lt;span style=&quot;color: #9696ff;&quot;&gt; logger&lt;/span&gt;&lt;span style=&quot;color: #d7d7d7;&quot;&gt;.&lt;/span&gt;&lt;span style=&quot;color: #3cbeff;&quot;&gt;info&lt;/span&gt;&lt;span style=&quot;color