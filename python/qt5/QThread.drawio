        <mxCell id="NDUoAskK0zCty8ZlMkvZ-3" value="&lt;div style=&quot;color: #433748;background-color: #f5f2f9;font-family: Consolas, &#39;Courier New&#39;, monospace;font-weight: normal;font-size: 14px;line-height: 19px;white-space: pre;&quot;&gt;&lt;div&gt;&lt;span style=&quot;color: #433748;&quot;&gt;&amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: #c05386;&quot;&gt;def&lt;/span&gt;&lt;span style=&quot;color: #433748;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: #668f9a;&quot;&gt;run&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #6b588e;&quot;&gt;self&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;)&lt;/span&gt;&lt;span style=&quot;color: #433748;&quot;&gt;:&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #433748;&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;&quot;&quot;&quot;运行处理任务&quot;&quot;&quot;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #433748;&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: #c05386;&quot;&gt;try&lt;/span&gt;&lt;span style=&quot;color: #433748;&quot;&gt;:&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #433748;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: #6b588e;font-style: italic;&quot;&gt;self&lt;/span&gt;&lt;span style=&quot;color: #433748;&quot;&gt;.&lt;/span&gt;&lt;span style=&quot;color: #6b588e;&quot;&gt;log_signal&lt;/span&gt;&lt;span style=&quot;color: #433748;&quot;&gt;.&lt;/span&gt;&lt;span style=&quot;color: #668f9a;&quot;&gt;emit&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #c05386;&quot;&gt;f&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;&quot;开始处理: &lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;{&lt;/span&gt;&lt;span style=&quot;color: #6b588e;font-style: italic;&quot;&gt;self&lt;/span&gt;&lt;span style=&quot;color: #433748;&quot;&gt;.&lt;/span&gt;&lt;span style=&quot;color: #6b588e;&quot;&gt;profile_url&lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;}&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;&quot;&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #433748;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #433748;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;# 检查是否应该继续运行&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #433748;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: #c05386;&quot;&gt;if&lt;/span&gt;&lt;span style=&quot;color: #433748;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: #c05386;&quot;&gt;not&lt;/span&gt;&lt;span style=&quot;color: #433748;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: #6b588e;font-style: italic;&quot;&gt;self&lt;/span&gt;&lt;span style=&quot;color: #433748;&quot;&gt;.&lt;/span&gt;&lt;span style=&quot;color: #6b588e;&quot;&gt;running&lt;/span&gt;&lt;span style=&quot;color: #433748;&quot;&gt;:&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #433748;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: #6b588e;font-style: italic;&quot;&gt;self&lt;/span&gt;&lt;span style=&quot;color: #433748;&quot;&gt;.&lt;/span&gt;&lt;span style=&quot;color: #6b588e;&quot;&gt;_error_flag&lt;/span&gt;&lt;span style=&quot;color: #433748;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: #c05386;&quot;&gt;=&lt;/span&gt;&lt;span style=&quot;color: #433748;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;True&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #433748;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: #6b588e;font-style: italic;&quot;&gt;self&lt;/span&gt;&lt;span style=&quot;color: #433748;&quot;&gt;.&lt;/span&gt;&lt;span style=&quot;color: #6b588e;&quot;&gt;_error_message&lt;/span&gt;&lt;span style=&quot;color: #433748;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: #c05386;&quot;&gt;=&lt;/span&gt;&lt;span style=&quot;color: #433748;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: #c05386;&quot;&gt;f&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;&quot;任务已取消: &lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;{&lt;/span&gt;&lt;span style=&quot;color: #6b588e;font-style: italic;&quot;&gt;self&lt;/span&gt;&lt;span style=&quot;color: #433748;&quot;&gt;.&lt;/span&gt;&lt;span style=&quot;color: #6b588e;&quot;&gt;profile_url&lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;}&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;&quot;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #433748;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: #6b588e;font-style: italic;&quot;&gt;self&lt;/span&gt;&lt;span style=&quot;color: #433748;&quot;&gt;.&lt;/span&gt;&lt;span style=&quot;color: #6b588e;&quot;&gt;finished_signal&lt;/span&gt;&lt;span style=&quot;color: #433748;&quot;&gt;.&lt;/span&gt;&lt;span style=&quot;color: #668f9a;&quot;&gt;emit&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;False&lt;/span&gt;&lt;span style=&quot;color: #433748;&quot;&gt;, &lt;/span&gt;&lt;span style=&quot;color: #6b588e;font-style: italic;&quot;&gt;self&lt;/span&gt;&lt;span style=&quot;color: #433748;&quot;&gt;.&lt;/span&gt;&lt;span style=&quot;color: #6b588e;&quot;&gt;_error_message&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #433748;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: #668f9a;&quot;&gt;print&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;&#39;任务已取消&#39;&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #433748;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: #c05386;&quot;&gt;return&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #433748;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #433748;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;# 执行处理&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #433748;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;# a=1/0&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;line-height: 19px;&quot;&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #c05386;&quot;&gt;except&lt;/span&gt; &lt;span style=&quot;color: #b5855c;&quot;&gt;Exception&lt;/span&gt; &lt;span style=&quot;color: #c05386;&quot;&gt;as&lt;/span&gt; &lt;span style=&quot;color: #6b588e;&quot;&gt;e&lt;/span&gt;:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #130718;&quot;&gt;# 处理失败&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #6b588e;font-style: italic;&quot;&gt;self&lt;/span&gt;.&lt;span style=&quot;color: #6b588e;&quot;&gt;_error_flag&lt;/span&gt; &lt;span style=&quot;color: #c05386;&quot;&gt;=&lt;/span&gt; &lt;span style=&quot;color: #c7792b;&quot;&gt;True&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #6b588e;&quot;&gt;error_msg&lt;/span&gt; &lt;span style=&quot;color: #c05386;&quot;&gt;=&lt;/span&gt; &lt;span style=&quot;color: #b5855c;&quot;&gt;str&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #6b588e;&quot;&gt;e&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #6b588e;font-style: italic;&quot;&gt;self&lt;/span&gt;.&lt;span style=&quot;color: #6b588e;&quot;&gt;_error_message&lt;/span&gt; &lt;span style=&quot;color: #c05386;&quot;&gt;=&lt;/span&gt; &lt;span style=&quot;color: #6b588e;&quot;&gt;error_msg&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #6b588e;font-style: italic;&quot;&gt;self&lt;/span&gt;.&lt;span style=&quot;color: #6b588e;&quot;&gt;log_signal&lt;/span&gt;.&lt;span style=&quot;color: #668f9a;&quot;&gt;emit&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #c05386;&quot;&gt;f&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;&quot;处理出错: &lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;{&lt;/span&gt;&lt;span style=&quot;color: #6b588e;&quot;&gt;error_msg&lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;}&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;&quot;&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #6b588e;font-style: italic;&quot;&gt;self&lt;/span&gt;.&lt;span style=&quot;color: #6b588e;&quot;&gt;finished_signal&lt;/span&gt;.&lt;span style=&quot;color: #668f9a;&quot;&gt;emit&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;False&lt;/span&gt;, &lt;span style=&quot;color: #c05386;&quot;&gt;f&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;&quot;处理失败: &lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;{&lt;/span&gt;&lt;span style=&quot;color: #6b588e;&quot;&gt;error_msg&lt;/span&gt;&lt;span style=&quot;color: #c7792b;&quot;&gt;}&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;&quot;&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #668f9a;&quot;&gt;print&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #377961;&quot;&gt;&#39;处理失败了！！！！&#39;&lt;/span&gt;,&lt;span style=&quot;color: #6b588e;&quot;&gt;error_msg&lt;/span&gt;&lt;span style=&quot;color: #130718;&quot;&gt;)&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;fontSize=18;" parent="NDUoAskK0zCty8ZlMkvZ-5" vertex="1">
